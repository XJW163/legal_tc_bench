  "experiments": [
    {
      "name": "gpt-oss-120b-baseline",
      "model": "gpt-oss-120b",
      "base_url": "http://10.12.143.51:8000/v1"
    },
    {
      "name": "qwen3-32b-baseline",
      "model": "Qwen3-32B",
      "base_url": "http://10.12.143.51:8000/v1",
      "enabled": false
    },
    {
      "name": "gpt-oss-120b-consistency-aware",
      "model": "gpt-oss-120b",
      "base_url": "http://10.12.143.51:8000/v1",
      "prompt_profile": "consistency-aware-v1",
      "context_paragraphs": 2,
      "enabled": false
    }
  ]

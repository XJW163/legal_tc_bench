{
  "input": "data/annotated",
  "output": "data/translations",
  "defaults": {
    "temperature": 0,
    "max_tokens": 4096,
    "max_retries": 5,
    "timeout_seconds": 300,
    "context_paragraphs": 0,
    "prompt_profile": "baseline-v1",
    "source_chunk_chars": 12000
